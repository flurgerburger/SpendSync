@page "/expenses"

<PageTitle>Expenses - SpendSync PH</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="font-bold flex items-center">
    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" Size="Size.Medium" />
    Expenses
</MudText>

<MudText Typo="Typo.body1" Class="text-slate-500 mb-6 font-normal">
    Log, manage, and categorize your day-to-day spending in Philippine Pesos (₱).
</MudText>

<MudPaper Class="p-6 transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-lg rounded-xl" Elevation="2" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true" Class="font-semibold text-slate-800">Expenses Placeholder</MudText>
    <MudText Typo="Typo.body2" Class="text-slate-600">
        This is the Expenses view. Expense tables and add/edit modals will be added here in the upcoming step.
    </MudText>
</MudPaper>
