@page "/"
@page "/dashboard"

<PageTitle>Dashboard - SpendSync PH</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="font-bold flex items-center">
    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" Size="Size.Medium" />
    Dashboard
</MudText>

<MudText Typo="Typo.body1" Class="text-slate-500 mb-6 font-normal">
    Welcome to SpendSync PH! Track your Philippine Peso (₱) budget, overview of monthly expenses, and active subscriptions.
</MudText>

<MudPaper Class="p-6 transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-lg rounded-xl" Elevation="2" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true" Class="font-semibold text-slate-800">Overview Placeholder</MudText>
    <MudText Typo="Typo.body2" Class="text-slate-600">
        This is the Dashboard landing page. Metrics and summaries will appear here in the next step.
    </MudText>
</MudPaper>
