@page "/subscriptions"

<PageTitle>Subscriptions - SpendSync PH</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="font-bold flex items-center">
    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="mr-2" Size="Size.Medium" />
    Subscriptions
</MudText>

<MudText Typo="Typo.body1" Class="text-slate-500 mb-6 font-normal">
    Monitor recurring charges (Netflix, Spotify, Internet, etc.) with automatic renewal alerts.
</MudText>

<MudPaper Class="p-6 transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-lg rounded-xl" Elevation="2" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true" Class="font-semibold text-slate-800">Subscriptions Placeholder</MudText>
    <MudText Typo="Typo.body2" Class="text-slate-600">
        This is the Subscriptions view. Recurring payments and renewal billing cycles will be configured here.
    </MudText>
</MudPaper>
