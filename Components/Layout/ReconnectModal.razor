<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet class="w-80 my-[20vh] mx-auto p-8 border-0 rounded-lg shadow-modal-elevated bg-white opacity-0 backdrop:bg-black/40 open:opacity-100 open:animate-reconnect-slide-up">
    <div class="flex flex-col items-center gap-4 text-center">
        <div class="components-rejoining-animation hidden [.components-reconnect-show_&]:block [.components-reconnect-retrying_&]:block relative w-20 h-20" aria-hidden="true">
            <div class="absolute inset-0 rounded-full border-[3px] border-reconnect-pulse animate-reconnect-pulse"></div>
            <div class="absolute inset-0 rounded-full border-[3px] border-reconnect-pulse animate-reconnect-pulse [animation-delay:-0.5s]"></div>
        </div>
        <p class="components-reconnect-first-attempt-visible hidden [.components-reconnect-show_&]:block m-0 text-center text-slate-700 text-sm font-medium">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible hidden [.components-reconnect-retrying_&]:block m-0 text-center text-slate-700 text-sm font-medium">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt" class="font-bold text-slate-900"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible hidden [.components-reconnect-failed_&]:block m-0 text-center text-slate-700 text-sm font-medium">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible hidden [.components-reconnect-failed_&]:inline-flex items-center justify-center border-0 bg-reconnect-blue hover:bg-reconnect-blue-dark active:bg-reconnect-blue text-white py-1 px-6 rounded text-sm font-medium cursor-pointer transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-reconnect-blue">
            Retry
        </button>
        <p class="components-pause-visible hidden [.components-reconnect-paused_&]:block m-0 text-center text-slate-700 text-sm font-medium">
            The session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible hidden [.components-reconnect-resume-failed_&]:block m-0 text-center text-slate-700 text-sm font-medium">
            Failed to resume the session.<br />Please retry or reload the page.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible hidden [.components-reconnect-paused_&]:inline-flex [.components-reconnect-resume-failed_&]:inline-flex items-center justify-center border-0 bg-reconnect-blue hover:bg-reconnect-blue-dark active:bg-reconnect-blue text-white py-1 px-6 rounded text-sm font-medium cursor-pointer transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-reconnect-blue">
            Resume
        </button>
    </div>
</dialog>
