<div class="d-flex align-center justify-space-between w-100">
    <!-- Brand / Logo -->
    <MudLink Href="" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.1; color: inherit;">SpendSync</MudText>
            <MudText Typo="Typo.caption" Style="opacity: 0.85; letter-spacing: 1px; font-weight: 600; color: inherit;">PHILIPPINES (₱)</MudText>
        </div>
    </MudLink>

    <!-- Navigation Links -->
    <MudNavMenu Class="d-flex flex-row align-center gap-1">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            Dashboard
        </MudNavLink>
        <MudNavLink Href="expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
            Expenses
        </MudNavLink>
        <MudNavLink Href="subscriptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Autorenew">
            Subscriptions
        </MudNavLink>
    </MudNavMenu>

    <!-- Currency / Quick Info Badge -->
    <div class="d-none d-md-flex align-center">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" Icon="@Icons.Material.Filled.LocalAtm">
            PHP (₱)
        </MudChip>
    </div>
</div>
