<div class="d-flex align-center justify-space-between w-100 gap-4">
    <MudLink Href="" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center text-inherit" Style="text-decoration:none;">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Color="Color.Primary" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h6" Style="font-weight:700; line-height:1.2;">SpendSync</MudText>
            <MudText Typo="Typo.caption" Style="letter-spacing:0.12em; text-transform:uppercase; opacity:0.8;">PHILIPPINES (₱)</MudText>
        </div>
    </MudLink>

    <MudNavMenu Class="d-flex flex-row align-center gap-1">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Style="color:#1E293B;">
            Dashboard
        </MudNavLink>
        <MudNavLink Href="subscriptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Autorenew" Style="color:#1E293B;">
            Subscriptions
        </MudNavLink>
        <MudNavLink Href="expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong" Style="color:#1E293B;">
            Expenses
        </MudNavLink>
    </MudNavMenu>

    <div class="d-none d-md-flex align-center gap-3">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Icon="@Icons.Material.Filled.LocalAtm">
            PHP (₱)
        </MudChip>
        <MudAvatar Color="Color.Primary" Size="Size.Medium">SP</MudAvatar>
    </div>
</div>
