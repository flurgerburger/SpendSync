<div class="flex items-center justify-between w-full">
    <MudLink Href="" Underline="Underline.None" Color="Color.Inherit" Class="flex items-center no-underline text-inherit group">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Class="mr-2 transition-transform duration-200 group-hover:scale-105" />
        <div>
            <MudText Typo="Typo.h6" Class="font-bold leading-tight text-inherit tracking-tight">SpendSync</MudText>
            <MudText Typo="Typo.caption" Class="opacity-85 tracking-widest font-semibold text-inherit text-xs uppercase">PHILIPPINES (₱)</MudText>
        </div>
    </MudLink>

    <MudNavMenu Class="flex flex-row items-center gap-1">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            Dashboard
        </MudNavLink>
        <MudNavLink Href="expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
            Expenses
        </MudNavLink>
        <MudNavLink Href="subscriptions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Autorenew">
            Subscriptions
        </MudNavLink>
    </MudNavMenu>

    <div class="hidden md:flex items-center">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" Icon="@Icons.Material.Filled.LocalAtm">
            PHP (₱)
        </MudChip>
    </div>
</div>
