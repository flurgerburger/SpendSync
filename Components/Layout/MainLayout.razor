@inherits LayoutComponentBase

<MudThemeProvider Theme="_currentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface" Fixed="true" Style="background:#FFFFFF; border-bottom:1px solid #E9ECEF; color:#1E293B;">
        <NavMenu />
    </MudAppBar>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 z-[2000] hidden w-full box-border bg-[#ffffe0] py-[0.65rem] px-5 shadow-[0_-1px_2px_rgba(0,0,0,0.2)] [color-scheme:light] text-neutral-800">
    An unhandled error has occurred.
    <a href="." class="reload ml-2 font-semibold text-primary underline hover:text-primary-dark">Reload</a>
    <span class="dismiss absolute right-3 top-2 cursor-pointer text-gray-500 hover:text-gray-900">🗙</span>
</div>

@code {
    private readonly MudTheme _currentTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#10B981",
            Secondary = "#1E293B",
            Background = "#F8F9FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#1E293B",
            TextSecondary = "#475569",
            Success = "#10B981",
            Warning = "#F59E0B",
            Info = "#2EC4B6",
            Divider = "#E9ECEF"
        }
    };
}
